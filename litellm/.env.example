# Exemplo de configuração local. Não use uma chave real neste arquivo versionado.
# Gere uma chave localmente, por exemplo: python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
# Coloque o valor gerado em litellm/.env (arquivo ignorado pelo Git).
LITELLM_MASTER_KEY=REPLACE_WITH_A_RANDOM_SECRET