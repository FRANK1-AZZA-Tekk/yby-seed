# =============================================================================
# YBY SEED — Variáveis de Ambiente (template)
# =============================================================================
# Como usar:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os valores reais
#   3. NUNCA faça commit do .env real (adicione ao .gitignore)
#
# Referências:
#   - Configuração LiteLLM: litellm_config.yaml
#   - Estratégia de custos: docs/PLANEJAMENTO-CUSTOS-IA.md
# =============================================================================

# -----------------------------------------------------------------------------
# OpenRouter (modelos em nuvem: free, Hermes, DeepSeek, Claude)
# Obtenha sua chave em: https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-substitua-pela-sua-chave

# -----------------------------------------------------------------------------
# LiteLLM Proxy (chave mestra para autenticar chamadas ao proxy)
# Gere uma chave segura com: openssl rand -hex 32
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-substitua-por-uma-chave-aleatoria-segura

# -----------------------------------------------------------------------------
# Ollama (modelos locais — nível 1 da pirâmide de custos)
# Padrão: http://localhost:11434
# -----------------------------------------------------------------------------
OLLAMA_API_BASE=http://localhost:11434
# Servidor Ollama (exporte antes de `ollama serve` se aplicável):
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=2
# Ping do hub keepalive e generate (opções por requisição):
YBY_OLLAMA_NUM_CTX=4096

# -----------------------------------------------------------------------------
# Modelo Ollama do alias yby-local (D4, 2026-11-11).
# Cabe em 16 GB RAM / 4 GB VRAM. Um modelo por vez.
# -----------------------------------------------------------------------------
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:3b

# -----------------------------------------------------------------------------
# Motor do `yby ask` (não commite chave real)
# Local por padrão (Ollama). Nuvem sob demanda, OpenAI-compatível:
#   1) OpenRouter (padrão free) — YBY_CLOUD_* ou OPENROUTER_API_KEY
#   2) Grok / xAI se OpenRouter falhar ou sem chave — YBY_GROK_* ou XAI_API_KEY
# Roteamento: src/engine/routing.py | failover: src/engine/providers.py
# -----------------------------------------------------------------------------
YBY_OLLAMA_BASE_URL=http://127.0.0.1:11434
YBY_LOCAL_MODEL=qwen2.5-coder:3b
YBY_OLLAMA_TIMEOUT=120
YBY_CLOUD_BASE_URL=https://openrouter.ai/api/v1
YBY_CLOUD_MODEL=openrouter/free
YBY_CLOUD_API_KEY=
# OPENROUTER_API_KEY=   # usada se YBY_CLOUD_API_KEY estiver vazia
YBY_CLOUD_TIMEOUT=120
YBY_GROK_BASE_URL=https://api.x.ai/v1
YBY_GROK_MODEL=grok-4.7
YBY_GROK_API_KEY=
# XAI_API_KEY=          # usada se YBY_GROK_API_KEY estiver vazia
YBY_CACHE_TTL_SECONDS=3600
YBY_CLOUD_CONTEXT_MAX_CHARS=12000
YBY_HEAVY_MIN_CHARS=1200
YBY_HEAVY_MIN_LINES=25
YBY_HEAVY_MIN_QUESTIONS=3
# YBY_HEAVY_PHRASES=pensa mais,pense mais,think harder
# Hub keepalive (systemd / yby hub)
# YBY_HUB_INTERVAL=60
# YBY_HUB_TIMEOUT=5

# -----------------------------------------------------------------------------
# Postgres do Learning Agent. Deixe vazio se não houver banco.
# Não coloque senha neste arquivo de exemplo com valor real.
# -----------------------------------------------------------------------------
YBY_DATABASE_URL=

# -----------------------------------------------------------------------------
# Gateway HTTP. O padrão escuta só em loopback e exige token.
# -----------------------------------------------------------------------------
FASTAPI_HOST=127.0.0.1
GATEWAY_TOKEN=

# -----------------------------------------------------------------------------
# Vault Obsidian. O Syncthing sincroniza esta pasta com o servidor de casa.
# -----------------------------------------------------------------------------
YBY_VAULT_PATH=

# -----------------------------------------------------------------------------
# Voz local (opcional). pip install -r requirements-voice.txt
# Whisper `base` em CPU cabe bem no hub; `small` se quiser mais qualidade.
# Piper: binário no PATH + caminho do .onnx da voz.
# -----------------------------------------------------------------------------
YBY_WHISPER_MODEL=base
YBY_WHISPER_DEVICE=cpu
YBY_WHISPER_COMPUTE=int8
YBY_VOICE_SAMPLE_RATE=16000
YBY_PIPER_BIN=piper
YBY_PIPER_MODEL=
YBY_PLAY_BIN=aplay

