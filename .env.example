# =============================================================================
# YBY SEED — Variáveis de Ambiente (template)
# =============================================================================
# Como usar:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os valores reais
#   3. NUNCA faça commit do .env real (adicione ao .gitignore)
#
# Referências:
#   - Configuração LiteLLM: litellm_config.yaml
#   - Estratégia de custos: docs/PLANEJAMENTO-CUSTOS-IA.md
# =============================================================================

# -----------------------------------------------------------------------------
# OpenRouter (modelos em nuvem: free, Hermes, DeepSeek, Claude)
# Obtenha sua chave em: https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-substitua-pela-sua-chave

# -----------------------------------------------------------------------------
# LiteLLM Proxy (chave mestra para autenticar chamadas ao proxy)
# Gere uma chave segura com: openssl rand -hex 32
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-substitua-por-uma-chave-aleatoria-segura

# -----------------------------------------------------------------------------
# Ollama (modelos locais — nível 1 da pirâmide de custos)
# Padrão: http://localhost:11434
# -----------------------------------------------------------------------------
OLLAMA_API_BASE=http://localhost:11434

# -----------------------------------------------------------------------------
# Opcional: modelo Ollama padrão para o nível yby-local
# Sugestões para 16 GB RAM / 4 GB VRAM: llama3.2:3b, qwen2.5:3b, phi3:mini
# -----------------------------------------------------------------------------
OLLAMA_DEFAULT_MODEL=llama3.2:3b
