# =============================================================================
# YBY SEED — Variáveis de Ambiente (template)
# =============================================================================
# Como usar:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os valores reais
#   3. NUNCA faça commit do .env real (adicione ao .gitignore)
#
# Referências:
#   - Configuração LiteLLM: litellm_config.yaml
#   - Estratégia de custos: docs/PLANEJAMENTO-CUSTOS-IA.md
# =============================================================================

# -----------------------------------------------------------------------------
# OpenRouter (modelos em nuvem: free, Hermes, DeepSeek, Claude)
# Obtenha sua chave em: https://openrouter.ai/keys
# -----------------------------------------------------------------------------
# Fundação (Passo 1/2) — preencha a chave OpenRouter se for usar nuvem.
# Vazio → yby_seed.py faz fallback automático para Ollama local.
OPENROUTER_API_KEY=
# Modelo OpenRouter (LiteLLM). Ex.: openrouter/meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL=openrouter/meta-llama/llama-3.2-3b-instruct:free

# -----------------------------------------------------------------------------
# LiteLLM Proxy (chave mestra para autenticar chamadas ao proxy)
# Gere uma chave segura com: openssl rand -hex 32
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-substitua-por-uma-chave-aleatoria-segura

# -----------------------------------------------------------------------------
# Ollama (modelos locais — nível 1 da pirâmide de custos)
# Padrão: http://localhost:11434
# OLLAMA_BASE_URL é o nome canônico do Passo 1; OLLAMA_API_BASE permanece
# como alias compatível com LiteLLM.
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434

# -----------------------------------------------------------------------------
# Opcional: modelo Ollama padrão para o nível yby-local
# Sugestões para 16 GB RAM / 4 GB VRAM: llama3.2:3b, qwen2.5:3b, phi3:mini
# -----------------------------------------------------------------------------
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# Tuning GTX 1650 4GB: num_ctx=2048 mantém llama3.2:3b 100% na GPU;
# 4096 já força offload e perde ~39% de tok/s (benchmarks públicos 2026).
YBY_OLLAMA_NUM_CTX=2048
YBY_OLLAMA_KEEP_ALIVE=10m
YBY_OLLAMA_TIMEOUT=120
YBY_OLLAMA_CONNECT_TIMEOUT=5

# Embeddings locais (Ollama). Nunca use vetores fictícios no código.
YBY_EMBED_MODEL=all-minilm

# -----------------------------------------------------------------------------
# Framework (Camada A) — opcional
# -----------------------------------------------------------------------------
# auto | ollama | openrouter
YBY_LLM_PROVIDER=auto
# dry_run | dry_run_safe_auto | deferred
YBY_SKILLS_MODE=dry_run
# none | local_files | qdrant
YBY_MEMORY_BACKEND=none
# YBY_DATA_DIR=.yby

# PostgreSQL (Fase 7 — LearningAgent). Sem senha no código-fonte.
# DATABASE_URL=postgresql://user:pass@localhost:5432/yby_seed
# YBY_DATABASE_URL=
