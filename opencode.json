{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "yby-engineer",
  "share": "disabled",
  "instructions": [".cursor/rules/yby.mdc", ".cursor/rules/yby-economy.mdc"],
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": ".git/*", "effect": "deny" },
    { "action": "read", "resource": "*/.git/*", "effect": "deny" },
    { "action": "read", "resource": "*.git-credentials*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*credential*", "effect": "deny" },
    { "action": "read", "resource": "*secret*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "src/*", "effect": "allow" },
    { "action": "edit", "resource": "tests/*", "effect": "allow" },
    { "action": "edit", "resource": "docs/*", "effect": "allow" },
    { "action": "edit", "resource": "src/safety/*", "effect": "ask" },
    { "action": "edit", "resource": "src/security/*", "effect": "ask" },
    { "action": "edit", "resource": "src/actions/*", "effect": "ask" },
    { "action": "edit", "resource": "*.env*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*credential*", "effect": "deny" },
    { "action": "edit", "resource": "*secret*", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "make check", "effect": "allow" },
    { "action": "shell", "resource": "make doctor", "effect": "allow" },
    { "action": "shell", "resource": "make lint", "effect": "allow" },
    { "action": "shell", "resource": "make test", "effect": "allow" },
    { "action": "shell", "resource": "pytest *", "effect": "allow" },
    { "action": "shell", "resource": "python -m pytest *", "effect": "allow" },
    { "action": "shell", "resource": "python3 -m pytest *", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/python -m pytest *", "effect": "allow" },
    { "action": "shell", "resource": "ruff check *", "effect": "allow" },
    { "action": "shell", "resource": "python -m ruff check *", "effect": "allow" },
    { "action": "shell", "resource": "python3 -m ruff check *", "effect": "allow" },
    { "action": "shell", "resource": ".venv/bin/python -m ruff check *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff --check *", "effect": "allow" },

    { "action": "shell", "resource": "*ruff*--fix*", "effect": "deny" },
    { "action": "shell", "resource": "*ruff*--unsafe-fixes*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git merge *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -f*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout . *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout *--force*", "effect": "deny" },
    { "action": "shell", "resource": "git restore *", "effect": "deny" },
    { "action": "shell", "resource": "git switch -f*", "effect": "deny" },
    { "action": "shell", "resource": "git switch *--force*", "effect": "deny" },
    { "action": "shell", "resource": "git switch *--discard-changes*", "effect": "deny" },
    { "action": "shell", "resource": "git stash *", "effect": "deny" },
    { "action": "shell", "resource": "git branch *-D*", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-repo *", "effect": "deny" },
    { "action": "shell", "resource": "git update-ref *", "effect": "deny" },
    { "action": "shell", "resource": "git reflog expire *", "effect": "deny" },
    { "action": "shell", "resource": "git gc *", "effect": "deny" },
    { "action": "shell", "resource": "git prune *", "effect": "deny" },

    { "action": "shell", "resource": "pip *", "effect": "deny" },
    { "action": "shell", "resource": "pip3 *", "effect": "deny" },
    { "action": "shell", "resource": "python -m pip *", "effect": "deny" },
    { "action": "shell", "resource": "python3 -m pip *", "effect": "deny" },
    { "action": "shell", "resource": ".venv/bin/pip *", "effect": "deny" },
    { "action": "shell", "resource": ".venv/bin/python -m pip *", "effect": "deny" },
    { "action": "shell", "resource": "pipx *", "effect": "deny" },
    { "action": "shell", "resource": "uv add *", "effect": "deny" },
    { "action": "shell", "resource": "uv pip *", "effect": "deny" },
    { "action": "shell", "resource": "uv sync *", "effect": "deny" },
    { "action": "shell", "resource": "uv tool *", "effect": "deny" },
    { "action": "shell", "resource": "uvx *", "effect": "deny" },
    { "action": "shell", "resource": "poetry *", "effect": "deny" },
    { "action": "shell", "resource": "conda *", "effect": "deny" },
    { "action": "shell", "resource": "npm *", "effect": "deny" },
    { "action": "shell", "resource": "npx *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm *", "effect": "deny" },
    { "action": "shell", "resource": "yarn *", "effect": "deny" },
    { "action": "shell", "resource": "bun *", "effect": "deny" },
    { "action": "shell", "resource": "bunx *", "effect": "deny" },
    { "action": "shell", "resource": "apt *", "effect": "deny" },
    { "action": "shell", "resource": "apt-get *", "effect": "deny" },
    { "action": "shell", "resource": "brew *", "effect": "deny" },
    { "action": "shell", "resource": "cargo install *", "effect": "deny" },
    { "action": "shell", "resource": "go install *", "effect": "deny" },
    { "action": "shell", "resource": "make setup *", "effect": "deny" },
    { "action": "shell", "resource": "make install-dev *", "effect": "deny" },
    { "action": "shell", "resource": "make clean *", "effect": "deny" },
    { "action": "shell", "resource": "make qdrant-*", "effect": "deny" },

    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "curl *", "effect": "deny" },
    { "action": "shell", "resource": "wget *", "effect": "deny" },
    { "action": "shell", "resource": "docker *", "effect": "deny" },
    { "action": "shell", "resource": "docker-compose *", "effect": "deny" },
    { "action": "shell", "resource": "podman *", "effect": "deny" },
    { "action": "shell", "resource": "systemctl *", "effect": "deny" },
    { "action": "shell", "resource": "service *", "effect": "deny" },
    { "action": "shell", "resource": "*install-hub-service*", "effect": "deny" },
    { "action": "shell", "resource": "vercel *", "effect": "deny" },
    { "action": "shell", "resource": "gh *", "effect": "deny" },
    { "action": "shell", "resource": "ssh *", "effect": "deny" },
    { "action": "shell", "resource": "scp *", "effect": "deny" },
    { "action": "shell", "resource": "rsync *", "effect": "deny" },
    { "action": "shell", "resource": "nc *", "effect": "deny" },

    { "action": "shell", "resource": "rm -r*", "effect": "deny" },
    { "action": "shell", "resource": "rm -f*", "effect": "deny" },
    { "action": "shell", "resource": "rm --recursive*", "effect": "deny" },
    { "action": "shell", "resource": "rm --force*", "effect": "deny" },
    { "action": "shell", "resource": "opencode *", "effect": "deny" },
    { "action": "shell", "resource": "ollama *", "effect": "deny" },
    { "action": "shell", "resource": "printenv *", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "*.env", "effect": "deny" },
    { "action": "shell", "resource": "*.env *", "effect": "deny" },
    { "action": "shell", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*.git/config*", "effect": "deny" },
    { "action": "shell", "resource": "*.git-credentials*", "effect": "deny" },
    { "action": "shell", "resource": "*.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "shell", "resource": "*.pem*", "effect": "deny" },

    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" }
  ],
  "agents": {
    "yby-engineer": {
      "description": "Engenharia assistida no yby-seed (branch, testes, PR). Siga AGENTS.md e docs/OPENCODE_INTEGRATION.md; nao e runtime do YBY.",
      "mode": "primary"
    }
  },
  "policies": [
    { "action": "mcp.use", "resource": "*", "effect": "deny" },
    { "action": "plugin.use", "resource": "*", "effect": "deny" },
    { "action": "skill.use", "resource": "*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git merge *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git clean *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git stash *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pip *", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:.git/*", "effect": "deny" },
    { "action": "tool.use", "resource": "subagent:*", "effect": "deny" }
  ]
}
