# Copie este arquivo para .env e substitua cada marcador localmente.
# Nunca coloque segredos reais em arquivos versionados ou mensagens.
# Para cada senha, gere valor aleatório longo com: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_SECRET

# Portas publicadas permanecem em 127.0.0.1. Para acesso remoto a uma UI,
# configure Tailscale Serve no host apenas para a porta necessária.
