{
  "name": "YBY SEED (PC Hub v1)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "workspaceFolder": "/workspaces/yby-seed",
  "shutdownAction": "none",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash",
    "python.defaultInterpreterPath": "/workspaces/yby-seed/.venv/bin/python",
    "editor.tabSize": 4,
    "files.trimTrailingWhitespace": true
  },
  "extensions": [
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-azuretools.vscode-docker",
    "redhat.vscode-yaml"
  ],
  "forwardPorts": [11434, 6333],
  "portsAttributes": {
    "11434": {
      "label": "Ollama (host ou container externo)"
    },
    "6333": {
      "label": "Qdrant (make qdrant-up, opcional)"
    }
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt -r requirements-dev.txt",
  "customInstructions": "v1 = venv + Ollama no host (qwen2.5-coder:3b). Sem Node-RED/Mosquitto neste repo. Testes: make check. Guia: docs/DEV.md.",
  "remoteUser": "vscode"
}