{
  "name": "YBY SEED Development",
  "dockerComposeFile": "../server/docker-compose.yml",
  "service": "node-red",
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "initializeCommand": "echo '🚀 Initializing YBY SEED Dev Container...'",
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash",
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.formatting.provider": "black",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "files.trimTrailingWhitespace": true
  },
  "extensions": [
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.black-formatter",
    "platformio.platformio-ide",
    "ms-azure-tools.vscode-docker",
    "redhat.vscode-yaml",
    "esbenp.prettier-vscode",
    "github.copilot",
    "github.copilot-chat"
  ],
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [
    1880,
    1883,
    4000,
    11434
  ],
  "portsAttributes": {
    "1880": {
      "label": "Node-RED",
      "onAutoForward": "notify"
    },
    "1883": {
      "label": "Mosquitto MQTT"
    },
    "4000": {
      "label": "LiteLLM Proxy"
    },
    "11434": {
      "label": "Ollama"
    }
  },
  "postCreateCommand": "bash /workspace/scripts/setup-dev.sh",
  "postStartCommand": "echo '✅ YBY SEED Dev Container ready! Access Node-RED at http://localhost:1880'",
  "customInstructions": "This dev container includes Python 3.11, PlatformIO, Docker-in-Docker, and GitHub CLI. All services (Mosquitto, Node-RED, Ollama, LiteLLM) run via docker-compose. Use `make test` to run tests.",
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  ]
}
